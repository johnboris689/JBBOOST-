NODE_ENV=production
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/JBBOOST
JWT_SECRET=generate-a-long-random-secret
JWT_REFRESH_SECRET=generate-a-different-long-random-secret
KORAPAY_SECRET_KEY=your-live-korapay-secret-key
KORAPAY_WEBHOOK_SECRET=your-korapay-webhook-secret
ADMIN_EMAIL=your-admin-email@example.com
ADMIN_PASSWORD=use-a-long-unique-admin-password
APP_URL=https://your-jbboost.onrender.com
SUPPORT_EMAIL=support@example.com
SUPPORT_PHONE=+2340000000000
WHATSAPP_NUMBER=2340000000000
GEMINI_API_KEY=optional

# JB Boster coin economy
NAIRA_PER_COIN=1.5
SMM_DEFAULT_MARKUP_PERCENT=50
SMM_AUTO_REFRESH_PRICES=true
SMM_USD_NGN_RATE=

# Existing provider (SMM PWR)
SMM_PROVIDER_NAME=smm_pwr
SMM_PROVIDER_API_URL=https://smmpwr.com/api/v2
SMM_PROVIDER_API_KEY=

# Additional compatible SMM API providers (optional)
SMM_PROVIDER_1_NAME=
SMM_PROVIDER_1_API_URL=
SMM_PROVIDER_1_API_KEY=
