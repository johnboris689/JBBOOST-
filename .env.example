# SMM Boost Panel Configuration
PORT=3000
NODE_ENV=development

# KoraPay
KORAPAY_SECRET_KEY=sk_live_your_korapay_secret_key
KORAPAY_PUBLIC_KEY=pk_live_your_korapay_public_key
KORAPAY_WEBHOOK_SECRET=

# Authentication & Security
JWT_SECRET=smm_super_secret_jwt_key_change_in_production_2025
JWT_REFRESH_SECRET=smm_super_secret_refresh_jwt_key_2025

# Payment Gateways (Naira / ₦)
# Get keys from https://dashboard.korapay.com/#/settings/developer
# Alternative Flutterwave keys
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxxxx

# Initial Admin Credentials (Seeded automatically if not present)
ADMIN_DEFAULT_EMAIL=admin@smmboost.ng
ADMIN_DEFAULT_PASSWORD=Admin123!

# Downstream SMM Reseller Provider API (Optional external fulfillment)
SMM_PROVIDER_API_URL=https://smm-provider.example.com/api/v2
SMM_PROVIDER_API_KEY=your_reseller_api_key

# PostgreSQL Connection String (When deploying to PostgreSQL / Supabase / RDS)
DATABASE_URL=postgres://postgres:password@localhost:5432/smm_boost_db

